{
  "name": "agtop",
  "version": "0.1.0",
  "description": "Terminal UI for monitoring AI coding agents on your system (Claude Code, Codex, Aider, Cursor, Gemini, Goose, etc.) — like top, but for agents.",
  "keywords": [
    "agent",
    "ai",
    "monitor",
    "tui",
    "terminal",
    "top",
    "htop",
    "btop",
    "claude",
    "codex",
    "aider",
    "cursor",
    "observability"
  ],
  "homepage": "https://github.com/mbrassey/agtop",
  "bugs": "https://github.com/mbrassey/agtop/issues",
  "license": "MIT",
  "author": "Matt Brassey <matt@brassey.io>",
  "main": "src/cli.js",
  "bin": {
    "agtop": "bin/agtop"
  },
  "files": [
    "bin/",
    "src/",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=16"
  },
  "scripts": {
    "start": "node bin/agtop",
    "test": "node test/smoke.js",
    "lint": "node -c bin/agtop && for f in src/*.js; do node -c \"$f\" || exit 1; done"
  },
  "dependencies": {
    "blessed": "^0.1.81",
    "blessed-contrib": "^4.11.0",
    "commander": "^12.1.0"
  },
  "os": [
    "linux",
    "darwin"
  ]
}
